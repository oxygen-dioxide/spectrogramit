<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SpectrogramIt.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:SpectrogramIt.Views"
    Title="SpectrogramIt">

    <FlyoutItem Title="SpectrogramIt" FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent
            Title="欢迎"
            ContentTemplate="{DataTemplate views:WelcomePage}"
            Route="Welcome" />
        <ShellContent
            Title="查看器"
            ContentTemplate="{DataTemplate views:ViewerPage}"
            Route="Viewer" />
        <ShellContent
            Title="设置"
            ContentTemplate="{DataTemplate views:SettingsPage}"
            Route="Settings" />
    </FlyoutItem>

</Shell>